library("tidyverse")
options(scipen = 999) #disable scientific notation
data(msleep,package="ggplot2")
glimpse(msleep)
msleep<-msleep
glimpse(msleep)
names(msleep)
?msleep
data(msleep, package = "ggplot2") # If ggplot2 is installed
# Count vore types
vore_counts <- table(msleep$vore)
# Base R barplot
barplot(vore_counts,
main = "Number of Mammals by Vore Type",
xlab = "Vore Type",
ylab = "Number of Mammals",
col = rainbow(length(vore_counts)))
#Herbivore is the most represented in the data
mean(msleep$sleep_total)
summary(msleep$bodywt)
ggplot(data=msleep,
mapping=aes(x=vore,y=bodywt))+geom_boxplot()+scale_y_log10()
ggplot(msleep, aes(x = sleep_total, y = bodywt)) +
geom_point() +
scale_y_log10()
